      if (CONFIG.actorItems) {
        for (const item of actor.items ?? []) {

          addEntry({
            document: item,
            type: "Actor Item",
            label: `   ⚔ ${actor.name} → ${item.name}`,
            uuid: item.uuid,
            id: item.id,
            parent: actor
          });
