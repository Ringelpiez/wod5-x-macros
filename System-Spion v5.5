(() => {
  "use strict";

  /*
   * ============================================================
   * SYSTEMSPION v5.5
   * Foundry VTT v13 / v14
   *
   * SYSTEMUNABHÄNGIG
   *
   * Untersucht:
   *   • World Actors
   *   • World Items
   *   • Items von Actors
   *   • ausgewählte Token-Actors
   *   • Items von ausgewählten Token-Actors
   *   • Actor-Compendien
   *   • Item-Compendien
   *
   * Funktionen:
   *   🔬 Daten
   *   🧬 Schema
   *   🔎 Suche
   *   📋 JSON exportieren
   *   📊 CSV exportieren
   *   📋 Pfad kopieren
   *   🗑 Leeren
   *
   * v5.5 Änderungen (gegenüber v5.4):
   *   • echter Fix für "Fenster füllt nicht den Platz" — die v5.4-
   *     CSS-Regel zielte auf .dialog-content, das es in Foundrys
   *     Dialog-Template gar nicht gibt (No-Op). Jetzt wird direkt
   *     das <form> zum Flex-Container, #ssp53 füllt den Rest
   *   • Close-Button/Footer bleibt dadurch am tatsächlichen unteren
   *     Rand statt im mittleren Drittel zu "schweben"
   *   • die 6 Toolbar-Buttons sind jetzt kompakter (kleinere
   *     Schrift/Padding) und ordnen sich bei normaler Fensterbreite
   *     in einer Zeile an, statt umzubrechen
   *
   * v5.4 Änderungen (gegenüber v5.3):
   *   • Dialog erhält jetzt echte Größen-Optionen (width/height/
   *     resizable) — ohne die war "frei veränderbar" gar nicht
   *     möglich, egal wie das interne CSS aussah
   *   • Innerer Aufbau auf Flex umgestellt (flex:1; min-height:0)
   *     statt fixer vh-Werte, damit sich der Datenbereich beim
   *     Ziehen am Fensterrand tatsächlich mitskaliert
   *   • .window-content bekommt per <style>-Block volle Höhe +
   *     Flex-Spalte, damit die Flex-Kinder überhaupt Raum haben
   *   • feste Dialog-id, damit Mehrfachaufruf des Makros nicht
   *     beliebig viele Fenster stapelt
   *   • getDocumentData(document) → getDocumentData(doc), da der
   *     Parametername zuvor den globalen document überschattet hat
   *   • v5.3 Änderungen (unverändert übernommen):
   *     - Compendium-Items unabhängig von Actors
   *     - sichere Download-Funktion
   *     - kein top-level await
   * ============================================================
   */

  const CONFIG = {
    maxDepth: 40,

    worldActors: true,
    worldItems: true,
    actorItems: true,
    selectedTokens: true,

    compendiumActors: true,
    compendiumItems: true
  };

  const BLOCKED_KEYS = new Set([
    "__proto__",
    "prototype",
    "constructor"
  ]);

  const entries = [];

  let currentEntry = null;
  let currentDocument = null;
  let currentData = null;
  let currentFields = [];

  // ============================================================
  // HILFSFUNKTIONEN
  // ============================================================

  function safeKey(key) {
    return !BLOCKED_KEYS.has(String(key));
  }

  function valueType(value) {
    if (value === null) return "null";
    if (value === undefined) return "undefined";
    if (Array.isArray(value)) return `Array[${value.length}]`;
    return typeof value;
  }

  function stringify(value) {
    if (value === undefined) return "undefined";
    if (value === null) return "null";

    if (typeof value === "string") {
      return value;
    }

    try {
      return JSON.stringify(value, null, 2);
    } catch {
      return String(value);
    }
  }

  function escapeHTML(value) {
    return String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }

  // Hinweis v5.4: Parameter heißt jetzt "doc" statt "document" —
  // vorher wurde innerhalb der Funktion der globale document
  // überschattet. Hat in v5.3 keinen Schaden angerichtet (die
  // Funktion griff nirgends auf document.* zu), war aber ein
  // Footgun für künftige Erweiterungen dieser Funktion.
  function getDocumentData(doc) {
    if (!doc) return null;

    if (typeof doc.toObject === "function") {
      try {
        return doc.toObject();
      } catch (error) {
        console.warn(
          "Systemspion: toObject() fehlgeschlagen.",
          error
        );
      }
    }

    return doc;
  }

  function addEntry(entry) {
    entries.push(entry);
  }

