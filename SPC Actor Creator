          <h3>Allgemeine Schwierigkeit</h3>
          <div class="g2">
            <div><label>Stärkster Gegner (1. Wert)</label> <input type="number" name="diffStrongest" value="${d.diffStrongest??2}" min="0" max="10" /></div>
            <div><label>Normal (2. Wert)</label>           <input type="number" name="diffNormal"    value="${d.diffNormal??1}"    min="0" max="10" /></div>
          </div>
          <h3>Erfahrungspunkte</h3>
          <div class="g2">
            <div><label>XP gesamt</label>    <input type="number" name="xpTotal"     value="${d.xpTotal??0}"     min="0" /></div>
            <div><label>XP verfügbar</label> <input type="number" name="xpRemaining" value="${d.xpRemaining??0}" min="0" /></div>
          </div>`;
      },
      collect: (html, s) => {
        s.d3 = {
          healthMax:     parseInt(html.find('[name="healthMax"]').val())     || 3,
          healthSup:     parseInt(html.find('[name="healthSup"]').val())     || 0,
          healthAgg:     parseInt(html.find('[name="healthAgg"]').val())     || 0,
          wpMax:         parseInt(html.find('[name="wpMax"]').val())         || 3,
          wpSup:         parseInt(html.find('[name="wpSup"]').val())         || 0,
          wpAgg:         parseInt(html.find('[name="wpAgg"]').val())         || 0,
          physical:      parseInt(html.find('[name="physical"]').val())      || 1,
          social:        parseInt(html.find('[name="social"]').val())        || 1,
          mental:        parseInt(html.find('[name="mental"]').val())        || 1,
          diffStrongest: parseInt(html.find('[name="diffStrongest"]').val()) || 2,
          diffNormal:    parseInt(html.find('[name="diffNormal"]').val())    || 1,
          xpTotal:       parseInt(html.find('[name="xpTotal"]').val())       || 0,
          xpRemaining:   parseInt(html.find('[name="xpRemaining"]').val())   || 0,
        };
      },
    },

    // ── 5: Exceptional Dice Pools ──────────────────────────────────────────
    {
      title: "SPC erstellen — 4/4: Exceptional Dice Pools",
      html: (s) => {
        const skillGroups = {
          "Physisch": ["athletics","brawl","craft","drive","firearms","larceny","melee","stealth","survival"],
          "Sozial":   ["animalken","etiquette","insight","intimidation","leadership","performance","persuasion","streetwise","subterfuge"],
          "Mental":   ["academics","awareness","finance","investigation","medicine","occult","politics","science","technology"],
        };
        const skillLabels = {
          athletics:"Athletik", brawl:"Kampf (waffenlos)", craft:"Handwerk",
          drive:"Fahren", firearms:"Schusswaffen", larceny:"Diebstahl",
          melee:"Nahkampf (bewaffnet)", stealth:"Heimlichkeit", survival:"Überleben",
          animalken:"Tierumgang", etiquette:"Etikette", insight:"Einfühlungsvermögen",
          intimidation:"Einschüchterung", leadership:"Führung", performance:"Auftreten",
          persuasion:"Überzeugung", streetwise:"Straßenwissen", subterfuge:"Täuschung",
          academics:"Akademisches", awareness:"Wahrnehmung", finance:"Finanzen",
          investigation:"Ermittlung", medicine:"Medizin", occult:"Okkultismus",
          politics:"Politik", science:"Naturwissenschaft", technology:"Technologie",
        };
        const savedSkills = s.d4skills || {};
        let html = `<p class="hint">Wert &gt; 0 aktiviert den Pool automatisch.
          <span style="color:#5a9;font-weight:bold;">●</span> = vom Text erkannt.</p>`;
        for (const [cat, skills] of Object.entries(skillGroups)) {
          html += `<h3>${cat}</h3><div class="g4">`;
          for (const sk of skills) {
            const preVal = savedSkills[sk] ?? s.p.skills[sk] ?? 0;
            html += `<div>
              <label>${skillLabels[sk]}${preVal>0?' <span style="color:#5a9;font-weight:bold;">●</span>':""}</label>
              <input type="number" name="skill_${sk}" value="${preVal}" min="0" max="20" />
            </div>`;
          }
          html += `</div>`;
        }
        return html;
      },
      collect: (html, s) => {
        const allSkills = [
          "athletics","brawl","craft","drive","firearms","larceny","melee","stealth","survival",
          "animalken","etiquette","insight","intimidation","leadership","performance","persuasion","streetwise","subterfuge",
          "academics","awareness","finance","investigation","medicine","occult","politics","science","technology",
        ];
        s.d4skills = {};
        for (const sk of allSkills) {
          s.d4skills[sk] = parseInt(html.find(`[name="skill_${sk}"]`).val()) || 0;
        }
      },
    },

    // ── 6: Typ-spezifisch + Bestätigung ───────────────────────────────────
    {
      title: "SPC erstellen — Typ-spezifisch & Bestätigung",
      nextLabel: "✅ Charakter anlegen",
      html: (s) => {
        const spcType = s.d1?.spcType || "mortal";
        const isV = ["vampire","ghoul"].includes(spcType);
        const isW = spcType === "werewolf";
        const isH = spcType === "hunter";
        const p   = s.p;
        const d3  = s.d3;

        const vHtml = isV ? `
          <h3>Vampir / Ghul</h3>
          <div class="g2">
            <div><label>Blutpotenz</label>       <input type="number" name="potency"    value="${p.potency}"    min="0" max="10" /></div>
            <div><label>Generation</label>       <input type="text"   name="generation" value="${p.generation}"               /></div>
            <div><label>Hunger (aktuell)</label> <input type="number" name="hunger"     value="${p.hunger}"     min="0" max="5"  /></div>
            <div><label>Humanität</label>        <input type="number" name="humanity"   value="${p.humanity}"   min="0" max="10" /></div>
            <div><label>Makel</label>            <input type="number" name="stains"     value="${p.stains}"     min="0" max="10" /></div>
            <div><label>Sire</label>             <input type="text"   name="sire"       value="${p.sire}"                      /></div>
            ${spcType==="ghoul"?`<div><label>Domitor</label><input type="text" name="domitor" value="${p.domitor}" /></div>`:""}
          </div>` : "";

        const wHtml = isW ? `
          <h3>Werwolf</h3>
          <div class="g2">
            <div><label>Rage (aktuell)</label><input type="number" name="rage" value="${p.rage}" min="0" max="5" /></div>
            <div>
              <label>Aktive Form</label>
              <select name="activeForm">
                ${["homid","glabro","crinos","hispo","lupus"].map(f =>
                  `<option value="${f}" ${p.activeForm===f?"selected":""}>${f.charAt(0).toUpperCase()+f.slice(1)}</option>`
                ).join("")}
              </select>
            </div>
            <div><label>Crinos Gesundheit Max</label><input type="number" name="crinosMax" value="${p.crinosMax}" min="1" max="20" /></div>
          </div>
          <h3>Renown</h3>
          <div class="g3">
            <div><label>Ruhm (Glory)</label>      <input type="number" name="glory"  value="${p.glory}"  min="0" max="5" /></div>
            <div><label>Ehre (Honor)</label>      <input type="number" name="honor"  value="${p.honor}"  min="0" max="5" /></div>
            <div><label>Weisheit (Wisdom)</label> <input type="number" name="wisdom" value="${p.wisdom}" min="0" max="5" /></div>
          </div>
          <h3>Balance</h3>
          <div class="g2">
            <div><label>Harano</label>   <input type="number" name="harano"   value="${p.harano}"   min="0" max="5" /></div>
            <div><label>Hauglosk</label> <input type="number" name="hauglosk" value="${p.hauglosk}" min="0" max="5" /></div>
          </div>` : "";

        const hHtml = isH ? `
          <h3>Jäger</h3>
          <div class="g2">
            <div><label>Despair</label>      <input type="number" name="despair"     value="${p.despair}"     min="0" max="5" /></div>
            <div><label>Desperation</label>  <input type="number" name="desperation" value="${p.desperation}" min="0" max="5" /></div>
            <div><label>Zelle</label>        <input type="text"   name="cellname"    value="${p.cellname}"                   /></div>
            <div><label>Credo-Felder</label> <input type="text"   name="creedfields" value="${p.creedfields}"                /></div>
          </div>` : "";

        const noExtra = (!isV && !isW && !isH)
          ? `<p class="hint">Für Typ <strong>${spcType}</strong> gibt es keine weiteren Felder.</p>` : "";

        return `
          ${noExtra}${vHtml}${wHtml}${hHtml}
          <h3 style="margin-top:18px;">Zusammenfassung</h3>
          <table style="width:100%;font-size:0.85em;border-collapse:collapse;">
            <tr><td style="font-weight:bold;padding:2px 6px;">Name</td>         <td>${s.d1?.name||"–"}</td></tr>
            <tr><td style="font-weight:bold;padding:2px 6px;">Typ</td>          <td>${spcType}</td></tr>
            <tr><td style="font-weight:bold;padding:2px 6px;">Gesundheit</td>   <td>Max ${d3?.healthMax??3}</td></tr>
            <tr><td style="font-weight:bold;padding:2px 6px;">Willenskraft</td> <td>Max ${d3?.wpMax??3}</td></tr>
            <tr><td style="font-weight:bold;padding:2px 6px;">Pools</td>        <td>Phys ${d3?.physical??1} / Soz ${d3?.social??1} / Men ${d3?.mental??1}</td></tr>
            <tr><td style="font-weight:bold;padding:2px 6px;">Difficulty</td>   <td>Strongest ${d3?.diffStrongest??2} / Normal ${d3?.diffNormal??1}</td></tr>
            <tr><td style="font-weight:bold;padding:2px 6px;">Gesperrt</td>     <td>${s.d1?.locked?"Ja":"Nein"}</td></tr>
          </table>`;
      },
      collect: (html, s) => {
        s.d5 = {
          potency:     parseInt(html.find('[name="potency"]').val())     || 0,
          generation:  html.find('[name="generation"]').val()?.trim()   || "",
          hunger:      parseInt(html.find('[name="hunger"]').val())      || 1,
          humanity:    parseInt(html.find('[name="humanity"]').val())    || 7,
          stains:      parseInt(html.find('[name="stains"]').val())      || 0,
          sire:        html.find('[name="sire"]').val()?.trim()          || "",
          domitor:     html.find('[name="domitor"]').val()?.trim()       || "",
          rage:        parseInt(html.find('[name="rage"]').val())        || 1,
          activeForm:  html.find('[name="activeForm"]').val()            || "homid",
          crinosMax:   parseInt(html.find('[name="crinosMax"]').val())   || 4,
          glory:       parseInt(html.find('[name="glory"]').val())       || 0,
          honor:       parseInt(html.find('[name="honor"]').val())       || 0,
          wisdom:      parseInt(html.find('[name="wisdom"]').val())      || 0,
          harano:      parseInt(html.find('[name="harano"]').val())      || 0,
          hauglosk:    parseInt(html.find('[name="hauglosk"]').val())    || 0,
          despair:     parseInt(html.find('[name="despair"]').val())     || 0,
          desperation: parseInt(html.find('[name="desperation"]').val()) || 0,
          cellname:    html.find('[name="cellname"]').val()?.trim()      || "",
          creedfields: html.find('[name="creedfields"]').val()?.trim()   || "",
        };
      },
    },

  ]; // Ende STEPS

  // ═══════════════════════════════════════════════════════════════════════════
  // SCHRITT-SCHLEIFE
  // ═══════════════════════════════════════════════════════════════════════════
  let stepIdx = 0;
  while (stepIdx < STEPS.length) {
    const step = STEPS[stepIdx];
    if (step.skip && step.skip(state)) { stepIdx++; continue; }
    const result = await showStep(
      step.title,
      step.html(state),
      { showBack: stepIdx > 0, nextLabel: step.nextLabel || "Weiter →" }
    );
    if (result.action === "cancel") { ui.notifications.warn("SPC-Makro abgebrochen."); return; }
    if (result.action === "back") {
      stepIdx--;
      while (stepIdx > 0 && STEPS[stepIdx].skip && STEPS[stepIdx].skip(state)) stepIdx--;
      continue;
    }
    if (step.collect(result.html, state) === false) continue;
    stepIdx++;
  }

  // ═══════════════════════════════════════════════════════════════════════════
  // Actor-Daten zusammenbauen & anlegen
  // ═══════════════════════════════════════════════════════════════════════════
  const { d1, d2, d3, d4skills, d5 } = state;
  const isVampire  = ["vampire","ghoul"].includes(d1.spcType);
  const isWerewolf = d1.spcType === "werewolf";
  const isHunter   = d1.spcType === "hunter";

  const exceptionaldicepools = {};
  for (const [sk, val] of Object.entries(d4skills)) {
    exceptionaldicepools[sk] = { active: val > 0, value: val, description: "", macroid: "", bonuses: [] };
  }

  const actorData = {
    name: d1.name, type: "spc",
    system: {
      locked: d1.locked, group: d1.group, spcType: d1.spcType,
      bio: {
        age:    { trueage: d2.trueage, apparent: d2.apparent },
        dateof: { birth: d2.birth, death: d2.death },
        history: d2.history,
      },
      headers: {
        concept: d1.concept, chronicle: d1.chronicle,
        ambition: d1.ambition, desire: d1.desire,
        touchstones: "", tenets: "",
        sire: d5.sire, generation: d5.generation,
        domitor: d5.domitor, creedfields: d5.creedfields, cellname: d5.cellname,
      },
      derivedXP:  { totalXP: d3.xpTotal, remainingXP: d3.xpRemaining },
      health:     { max: d3.healthMax, value: d3.healthMax, superficial: d3.healthSup, aggravated: d3.healthAgg },
      willpower:  { max: d3.wpMax,     value: d3.wpMax,     superficial: d3.wpSup,     aggravated: d3.wpAgg     },
      description:  d2.description,
      appearance:   d2.appearance,
      notes:        d2.notes,
      privatenotes: d2.privatenotes,   // ← enthält Intro-Text + Notes/Other Traits
      biography:    d2.history,
      equipment:    d2.equipment,
      standarddicepools: {
        physical: { value: d3.physical },
        social:   { value: d3.social },
        mental:   { value: d3.mental },
      },
      generaldifficulty: { normal: d3.diffNormal, strongest: d3.diffStrongest },
      exceptionaldicepools,
      settings: {
        generalDifficultyEnabled: true, skillAttributeInputs: false,
        enableDisciplines: isVampire, enableGifts: isWerewolf, enableEdges: isHunter,
        limited: { biography: true, appearance: true, touchstones: false, tenets: false },
      },
      hunger:      { value: isVampire  ? d5.hunger    : 1,  max: 5 },
      humanity:    { value: isVampire  ? d5.humanity   : 7,  stains: isVampire ? d5.stains : 0 },
      blood:       { potency: isVampire ? d5.potency   : 0,  generation: isVampire ? d5.generation : "" },
      rage:        { value: isWerewolf ? d5.rage       : 1,  max: 5 },
      activeForm:  isWerewolf ? d5.activeForm : "homid",
      crinosHealth:{ max: isWerewolf ? d5.crinosMax : 4, value: isWerewolf ? d5.crinosMax : 4, superficial: 0, aggravated: 0 },
      renown: {
        glory:  { value: isWerewolf ? d5.glory  : 0 },
        honor:  { value: isWerewolf ? d5.honor  : 0 },
        wisdom: { value: isWerewolf ? d5.wisdom : 0 },
      },
      balance: {
        harano:   { value: isWerewolf ? d5.harano   : 0 },
        hauglosk: { value: isWerewolf ? d5.hauglosk : 0 },
      },
      frenzyActive: false, lostTheWolf: false,
      despair:     { value: isHunter ? d5.despair     : 0 },
      desperation: { value: isHunter ? d5.desperation : 0 },
    },
    flags: { wod5e: { manualDefaultOwnership: true } },
  };

  try {
    const actor = await Actor.create(actorData);
    ui.notifications.info(`✅ SPC „${actor.name}" erfolgreich angelegt!`);
    setTimeout(() => {
      const a = game.actors.get(actor.id);
      if (a) a.sheet.render(true);
    }, 300);
  } catch (err) {
    console.error("WoD SPC Creator – Fehler:", err);
    ui.notifications.error(`Fehler beim Anlegen: ${err.message}`);
  }

})();
