// WoD5e Gift & Rite Item Creator – V6.1
// FoundryVTT V13 | System: wod5e 5.3.x
//
// Verwendet WOD5E.Attributes.getList() / WOD5E.Skills.getList()
//           WOD5E.Gifts.getList()      / WOD5E.Renown.getList()
// für automatische Lokalisierung und Unterstützung benutzerdefinierter Felder.

(async () => {

  const AppV2 = foundry.applications.api.ApplicationV2;

  // ─── i18n-Helfer (nur noch für Strings ohne getList()-Abdeckung) ───────────
  const L = (key) => game.i18n.localize(key);

  // ═══════════════════════════════════════════════════════════════════════════
  // DYNAMISCHE LISTEN via wod5e-API
  // Jede Funktion wird zur Laufzeit aufgerufen, damit Custom-Felder enthalten sind.
  // ═══════════════════════════════════════════════════════════════════════════

  // Anzeigetyp Gift vs. Rite (beide intern type:"gift")
  const DISPLAY_TYPES = () => [
    { value: "gift", label: L("WOD5E.WTA.Gift") },
    { value: "rite", label: L("WOD5E.WTA.Rite") },
  ];

  // Gift-Typen vollständig aus WOD5E.Gifts.getList() – inkl. Custom-Gifts,
  // bereits lokalisiert, hidden-Flag wird respektiert.
  // "rite" wird herausgefiltert (eigene Sektion).
  const GIFT_TYPES = () => {
    const raw = WOD5E.Gifts.getList({});
    return Object.entries(raw)
      .filter(([k, v]) => k !== "rite" && !v.hidden)
      .map(([k, v]) => ({ value: k, label: v.displayName ?? v.label ?? k }));
  };

  // Rite-Typ direkt aus getList() – label wird damit auch lokalisiert/umbenannt
  const RITE_GIFT_TYPES = () => {
    const raw = WOD5E.Gifts.getList({});
    const rite = raw["rite"];
    return [{ value: "rite", label: rite?.displayName ?? rite?.label ?? L("WOD5E.WTA.Rite") }];
  };

  // Renown-Typen aus WOD5E.Renown.getList() – lokalisiert, Custom-Renown inklusive
  const RENOWN_TYPES = () => {
    const raw = WOD5E.Renown.getList({});
    return Object.entries(raw)
      .filter(([, v]) => !v.hidden)
      .map(([k, v]) => ({ value: k, label: v.displayName ?? v.label ?? k }));
  };

  // ─── Würfelpool-Einträge aus getList() ────────────────────────────────────
  // getList({ useValuePaths: true }) liefert path-Felder direkt
  const POOL_OPTIONS = () => {
    const opts = [];
    const renownLabel = L("WOD5E.WTA.Renown");

    // Attribute
    try {
      const attrs = WOD5E.Attributes.getList({ useValuePaths: true });
      for (const [, v] of Object.entries(attrs)) {
        if (v.hidden) continue;
        opts.push({ value: v.path, label: v.displayName ?? v.label ?? v.path });
      }
    } catch { /* ignorieren */ }

    // Renown aus WOD5E.Renown.getList()
    // path = "system.renown.glory.value" → für Dicepool "system." Präfix entfernen
    try {
      const renowns = WOD5E.Renown.getList({});
      for (const [, v] of Object.entries(renowns)) {
        if (v.hidden) continue;
        const dicepoolPath = v.path.replace(/^system\./, "").replace(/\.value$/, "");
        opts.push({ value: dicepoolPath, label: `${renownLabel}: ${v.displayName ?? v.label}` });
      }
    } catch {
      opts.push({ value: "renown.glory",  label: `${renownLabel}: ${L("WOD5E.WTA.Glory")}`  });
      opts.push({ value: "renown.honor",  label: `${renownLabel}: ${L("WOD5E.WTA.Honor")}`  });
      opts.push({ value: "renown.wisdom", label: `${renownLabel}: ${L("WOD5E.WTA.Wisdom")}` });
    }

    // Skills
    try {
      const skills = WOD5E.Skills.getList({ useValuePaths: true });
      for (const [, v] of Object.entries(skills)) {
        if (v.hidden) continue;
        opts.push({ value: v.path, label: v.displayName ?? v.label ?? v.path });
      }
    } catch { /* ignorieren */ }

    return opts;
  };

  // ─── ATTR_MAP für den Text-Parser: aus getList() dynamisch aufbauen ───────
  // Mappt englische Kleinbuchstaben-Namen auf interne Pfade.
  // Deckt auch Custom-Attribute/Skills ab.
  const buildAttrMap = () => {
    const map = {};

    // Renown aus getList() – path kürzen wie in POOL_OPTIONS()
    try {
      const renowns = WOD5E.Renown.getList({});
      for (const [k, v] of Object.entries(renowns)) {
        const dicepoolPath = v.path.replace(/^system\./, "").replace(/\.value$/, "");
        map[k.toLowerCase()] = dicepoolPath;
        if (v.label) map[v.label.toLowerCase()] = dicepoolPath;
      }
    } catch {
      map["glory"]   = "renown.glory";
      map["honor"]   = "renown.honor";
      map["wisdom"]  = "renown.wisdom";
    }
    // Englische Parser-Aliasse immer erhalten (Regelwerkstexte sind EN)
    map["glory"]   = map["glory"]   ?? "renown.glory";
    map["honor"]   = map["honor"]   ?? "renown.honor";
    map["wisdom"]  = map["wisdom"]  ?? "renown.wisdom";
    map["ruhm"]    = map["glory"];
    map["ehre"]    = map["honor"];
    map["weisheit"]= map["wisdom"];

    // Attribute aus getList()
    try {
      const attrs = WOD5E.Attributes.getList({ useValuePaths: true });
      for (const [k, v] of Object.entries(attrs)) {
        if (v.hidden) continue;
        // key (z.B. "strength") und label in Kleinbuchstaben als Suchschlüssel
        map[k.toLowerCase()] = v.path;
        if (v.label) map[v.label.toLowerCase()] = v.path;
      }
    } catch {
      // Fallback: Basis-Attribute
      for (const [k, p] of Object.entries({
        strength:"attributes.strength", dexterity:"attributes.dexterity",
        stamina:"attributes.stamina",   charisma:"attributes.charisma",
        manipulation:"attributes.manipulation", composure:"attributes.composure",
        intelligence:"attributes.intelligence", wits:"attributes.wits",
        resolve:"attributes.resolve",
      })) { map[k] = p; }
    }

    // Skills aus getList()
    try {
      const skills = WOD5E.Skills.getList({ useValuePaths: true });
      for (const [k, v] of Object.entries(skills)) {
        if (v.hidden) continue;
        map[k.toLowerCase()] = v.path;
        if (v.label) map[v.label.toLowerCase()] = v.path;
        // Aliasse
        if (k === "animalken") map["animal ken"] = v.path;
        if (k === "craft")     map["crafts"]     = v.path;
      }
    } catch {
      // Fallback: Basis-Skills
      for (const [k, p] of Object.entries({
        athletics:"skills.athletics", brawl:"skills.brawl", craft:"skills.craft",
        crafts:"skills.craft", drive:"skills.drive", firearms:"skills.firearms",
        melee:"skills.melee", stealth:"skills.stealth", survival:"skills.survival",
        animalken:"skills.animalken", "animal ken":"skills.animalken",
        etiquette:"skills.etiquette", insight:"skills.insight",
        intimidation:"skills.intimidation", leadership:"skills.leadership",
        performance:"skills.performance", persuasion:"skills.persuasion",
        streetwise:"skills.streetwise", subterfuge:"skills.subterfuge",
        academics:"skills.academics", awareness:"skills.awareness",
        finance:"skills.finance", investigation:"skills.investigation",
        medicine:"skills.medicine", occult:"skills.occult", politics:"skills.politics",
        science:"skills.science", technology:"skills.technology", larceny:"skills.larceny",
      })) { map[k] = p; }
    }

    return map;
  };

  // ═══════════════════════════════════════════════════════════════════════════
  // TEXT-PARSER
  // ═══════════════════════════════════════════════════════════════════════════
  const RENOWN_MAP = {
    "glory":"glory", "ruhm":"glory",
    "honor":"honor", "ehre":"honor",
    "wisdom":"wisdom", "weisheit":"wisdom",
  };

  function parsePoolString(raw, attrMap) {
    if (!raw) return [];
    const left  = raw.split(/\s+vs\.?\s+/i)[0];
    const parts = left.split(/\s*\+\s*/);
    const out   = [];
    for (const part of parts) {
      const key   = part.trim().toLowerCase().replace(/\s+/g, " ");
      const match = Object.keys(attrMap)
        .filter(k => key === k || key.startsWith(k))
        .sort((a, b) => b.length - a.length)[0];
      if (match) out.push({ path: attrMap[match] });
    }
    return out;
  }

  function parseGiftBlock(raw, attrMap) {
    const result = {
      itemName:"", giftType:"native", renown:"glory",
      level:1, cost:0, willpowercost:0,
      sourceBook:"", sourcePage:"", pool:[], description:"",
      isRite:false, poolExplicit:false,
    };
    if (!raw.trim()) return result;

    const lines    = raw.split("\n").map(l => l.trim()).filter(Boolean);
    const fieldPfx = /^(renown|cost|action|pool|system|duration|source|page)\s*[:：]/i;

    for (const line of lines) {
      if (!fieldPfx.test(line)) {
        result.itemName = line.replace(/^[-–—*#]+\s*/, "").trim();
        break;
      }
    }

    const descLines   = [];
    let systemSection = false;

    for (const line of lines) {
      if (line === result.itemName) continue;

      if (/^renown\s*[:：]/i.test(line)) {
        const v2    = line.replace(/^renown\s*[:：]\s*/i, "").trim().toLowerCase();
        const found = Object.keys(RENOWN_MAP).find(k => v2.startsWith(k) || v2.includes(k));
        result.renown = found ? RENOWN_MAP[found] : "glory";
        systemSection = false; continue;
      }

      if (/^cost\s*[:：]/i.test(line)) {
        const val = line.replace(/^cost\s*[:：]\s*/i, "").trim();
        const num = parseInt((val.match(/(\d+)/) || [])[1]) || 1;
        if (/willpower|willenskraft/i.test(val)) {
          result.willpowercost = num; result.cost = 0;
        } else {
          result.cost = num; result.willpowercost = 0;
        }
        systemSection = false; continue;
      }

      if (/^pool\s*[:：]/i.test(line)) {
        result.poolExplicit = true;
        const pv = line.replace(/^pool\s*[:：]\s*/i, "").trim();
        if (!/^[-–—]+$/.test(pv) && pv !== "") {
          result.pool = parsePoolString(pv, attrMap);
        }
        systemSection = false; continue;
      }

      if (/^action\s*[:：]/i.test(line)) {
        descLines.push(`<strong>Action:</strong> ${line.replace(/^action\s*[:：]\s*/i,"").trim()}`);
        systemSection = false; continue;
      }
      if (/^duration\s*[:：]/i.test(line)) {
        descLines.push(`<strong>Duration:</strong> ${line.replace(/^duration\s*[:：]\s*/i,"").trim()}`);
        systemSection = false; continue;
      }
      if (/^source\s*[:：]/i.test(line)) {
        result.sourceBook = line.replace(/^source\s*[:：]\s*/i,"").trim();
        systemSection = false; continue;
      }
      if (/^page\s*[:：]/i.test(line)) {
        result.sourcePage = line.replace(/^page\s*[:：]\s*/i,"").trim();
        systemSection = false; continue;
      }
      if (/^system\s*[:：]/i.test(line)) {
        systemSection = true;
        const rest = line.replace(/^system\s*[:：]\s*/i,"").trim();
        if (rest) descLines.push(`<strong>${L("WOD5E.System")}:</strong> ${rest}`);
        continue;
      }
      if (systemSection) { descLines.push(line); continue; }
      if (/^\(.*p\.\s*\d+/i.test(line)) {
        const m = line.match(/p\.\s*(\d+)/i);
        if (m && !result.sourcePage) result.sourcePage = m[1];
        continue;
      }
      descLines.push(line);
    }

    if (descLines.length) result.description = descLines.map(l => `<p>${l}</p>`).join("");
    // Fallback nur wenn gar keine Pool:-Zeile im Text stand
    if (!result.poolExplicit && !result.pool.length) result.pool = [
      { path: "attributes.strength" },
      { path: "renown.glory" },
    ];
    return result;
  }

  // ═══════════════════════════════════════════════════════════════════════════
  // ZUSTAND  (attrMap einmalig aufbauen)
  // ═══════════════════════════════════════════════════════════════════════════
  const ATTR_MAP = buildAttrMap();

  const state = {
    mode:"text", rawText:"", parsed:parseGiftBlock("", ATTR_MAP),
    d1:null, d2:null, d3:null,
  };

  // ═══════════════════════════════════════════════════════════════════════════
  // HILFS-FUNKTIONEN
  // ═══════════════════════════════════════════════════════════════════════════
  function optHtml(arr, selectedVal) {
    return arr.map(o =>
      `<option value="${o.value}" ${o.value === selectedVal ? "selected" : ""}>${o.label}</option>`
    ).join("");
  }

  function poolOptHtml(selectedVal) {
    return POOL_OPTIONS().map(o =>
      `<option value="${o.value}" ${o.value === selectedVal ? "selected" : ""}>${o.label}</option>`
    ).join("");
  }

  function poolEntryLabel(idx) {
    return `${L("WOD5E.Tabs.Dicepool")} ${idx + 1}`;
  }

  // ─── Basis-CSS ─────────────────────────────────────────────────────────────
  const baseStyle = `
    <style>
      .wf label         { display:block; margin-top:7px; font-weight:bold;
                          font-size:0.82em; color:var(--color-text-dark-secondary,#555); }
      .wf input,.wf select,.wf textarea
                        { width:100%; box-sizing:border-box; margin-top:2px; }
      .wf textarea      { resize:vertical; }
      .wf h3            { border-bottom:1px solid var(--color-border-light-primary,#aaa);
                          margin:14px 0 4px; font-size:0.95em; }
      .wf .g2           { display:grid; grid-template-columns:1fr 1fr; gap:8px; }
      .wf .g3           { display:grid; grid-template-columns:1fr 1fr 1fr; gap:8px; }
      .wf .hint         { font-size:0.82em; color:var(--color-text-dark-secondary,#666);
                          margin-bottom:4px; line-height:1.5; }
      .wf code          { background:var(--color-bg-option,#eee); padding:1px 4px;
                          border-radius:3px; font-size:0.9em; }
      .wf .cb-row       { display:flex; align-items:center; gap:6px; margin-top:8px; }
      .wf .cb-row input { width:auto; margin:0; }
      .wf .cb-row label { font-weight:normal; margin:0; }
      .wf .pool-row     { display:grid; grid-template-columns:1fr 36px; gap:6px;
                          align-items:end; margin-top:6px; }
      .wf .pool-row button { margin-top:0; width:100%; }
      .wf table         { width:100%; font-size:0.85em; border-collapse:collapse; }
      .wf table td      { padding:3px 6px; }
      .wf table tr:nth-child(even) td { background:var(--color-bg-option,#f4f4f4); }
    </style>`;

  // ═══════════════════════════════════════════════════════════════════════════
  // WÜRFELPOOL-VERWALTUNG
  // ═══════════════════════════════════════════════════════════════════════════
  function buildPoolRowHTML(idx, pathValue) {
    return `
      <div class="pool-row" data-pool-row="${idx}">
        <div>
          <label>${poolEntryLabel(idx)}</label>
          <select name="pool_path_${idx}">${poolOptHtml(pathValue)}</select>
        </div>
        <div style="display:flex;align-items:flex-end;">
          <button type="button" data-remove-row="${idx}"
            style="margin-top:20px;width:100%;">✕</button>
        </div>
      </div>`;
  }

  function renderPoolRows(pool) {
    return pool.map((e, i) => buildPoolRowHTML(i, e.path)).join("");
  }

  function renumberPoolRows(containerEl) {
    containerEl.querySelectorAll("[data-pool-row]").forEach((row, i) => {
      row.setAttribute("data-pool-row", i);
      const sel = row.querySelector("select");  if (sel) sel.name = `pool_path_${i}`;
      const lbl = row.querySelector("label");   if (lbl) lbl.textContent = poolEntryLabel(i);
      const btn = row.querySelector("[data-remove-row]");
      if (btn) btn.setAttribute("data-remove-row", i);
    });
  }

  function reattachPoolListeners(containerEl) {
    containerEl.addEventListener("click", (ev) => {
      const btn = ev.target.closest("[data-remove-row]");
      if (!btn) return;
      btn.closest("[data-pool-row]")?.remove();
      renumberPoolRows(containerEl);
    });
    containerEl.parentElement?.querySelector("#btn-add-pool")
      ?.addEventListener("click", () => {
        const idx = containerEl.querySelectorAll("[data-pool-row]").length;
        const div = document.createElement("div");
        // Ersten nicht-hidden Attribut-Pfad als Default verwenden
        const firstAttr = (() => {
          try {
            const attrs = WOD5E.Attributes.getList({ useValuePaths: true });
            const first = Object.values(attrs).find(v => !v.hidden);
            return first?.path ?? "attributes.strength";
          } catch { return "attributes.strength"; }
        })();
        div.innerHTML = buildPoolRowHTML(idx, firstAttr);
        containerEl.appendChild(div.firstElementChild);
      });
  }

  // ═══════════════════════════════════════════════════════════════════════════
  // SCHRITT-DEFINITIONEN
  // ═══════════════════════════════════════════════════════════════════════════
  const STEPS = [

    // ── Schritt 0: Eingabemodus ────────────────────────────────────────────
    {
      title: L("WOD5E.WTA.GiftsandRites"),
      html: (s) => `
        <h3>${L("WOD5E.ItemsList.Type")}</h3>
        <div class="cb-row" style="margin-top:12px;">
          <input type="radio" name="mode" id="mode_text" value="text"
            ${s.mode==="text" ? "checked" : ""} />
          <label for="mode_text">
            <strong>${L("WOD5E.WTA.GiftsandRites")}</strong>
            — ${L("WOD5E.WTA.AddGift")} / ${L("WOD5E.WTA.AddRite")}
          </label>
        </div>
        <div class="cb-row" style="margin-top:6px;">
          <input type="radio" name="mode" id="mode_manual" value="manual"
            ${s.mode==="manual" ? "checked" : ""} />
          <label for="mode_manual">
            <strong>${L("WOD5E.WTA.NewGift")} / ${L("WOD5E.WTA.NewRite")}</strong>
            — ${L("WOD5E.ItemsList.Items")}
          </label>
        </div>`,
      collect: (html, s) => { s.mode = html.find('[name="mode"]:checked').val() || "text"; },
      postRender: null,
    },

    // ── Schritt 1: Textblock ───────────────────────────────────────────────
    {
      title: `${L("WOD5E.WTA.GiftsandRites")} — ${L("WOD5E.ItemsList.Label")}`,
      nextLabel: `${L("WOD5E.Submit") ?? "Submit"} →`,
      skip: (s) => s.mode !== "text",
      html: (s) => `
        <p class="hint">
          ${L("WOD5E.WTA.GiftsandRites")} — ${L("WOD5E.WTA.AddGift")} / ${L("WOD5E.WTA.AddRite")}
        </p>
        <p class="hint">
          ${L("WOD5E.WTA.Renown")}: <code>Honor</code> &nbsp;·&nbsp;
          ${L("WOD5E.WTA.RageCost")}: <code>1</code> &nbsp;·&nbsp;
          ${L("WOD5E.WTA.WillpowerCost")}: <code>1 Willpower</code><br>
          <code>Pool: Composure + Honor</code> &nbsp;·&nbsp;
          <code>Pool: Strength + Glory vs Resolve + Insight</code><br>
          <code>Pool: —</code> → ${L("WOD5E.ItemsList.NoDiceSelectedHint")}<br>
          <code>System: …</code> &nbsp;·&nbsp; <code>Duration: …</code>
        </p>
        <label>${L("WOD5E.WTA.GiftsandRites")}</label>
        <textarea name="rawtext" rows="14"
          style="font-family:monospace;font-size:0.82em;"
          placeholder="${L("WOD5E.WTA.NewGift")} / ${L("WOD5E.WTA.NewRite")} …"
          >${s.rawText}</textarea>`,
      collect: (html, s) => {
        s.rawText = html.find('[name="rawtext"]').val() || "";
        if (!s.rawText.trim()) {
          ui.notifications.error(L("WOD5E.WTA.NoGiftSelected")); return false;
        }
        s.parsed = parseGiftBlock(s.rawText, ATTR_MAP);
      },
      postRender: null,
    },

    // ── Schritt 2: Grunddaten ──────────────────────────────────────────────
    {
      title: `${L("WOD5E.WTA.GiftsandRites")} — 1/3`,
      html: (s) => {
        const p = s.parsed;
        const d = s.d1 ?? {};
        const displayType   = d.displayType   ?? (p.isRite ? "rite" : "gift");
        const itemName      = d.itemName      ?? p.itemName      ?? "";
        const giftType      = d.giftType      ?? p.giftType      ?? "native";
        const riteGiftType  = (d.isRite ? d.giftType : null) ?? "rite";
        const renown        = d.renown        ?? p.renown        ?? "glory";
        const level         = d.level         ?? p.level         ?? 1;
        const cost          = d.cost          ?? p.cost          ?? 0;
        const willpowercost = d.willpowercost ?? p.willpowercost ?? 0;
        const sourceBook    = d.sourceBook    ?? p.sourceBook    ?? "";
        const sourcePage    = d.sourcePage    ?? p.sourcePage    ?? "";

        return `
          <h3>${L("WOD5E.WTA.GiftType")} &amp; ${L("WOD5E.Name")}</h3>
          <div class="g2">
            <div>
              <label>${L("WOD5E.WTA.GiftType")}</label>
              <select name="displayType" id="sel-displaytype">
                ${optHtml(DISPLAY_TYPES(), displayType)}
              </select>
            </div>
            <div>
              <label>${L("WOD5E.Name")} *</label>
              <input type="text" name="itemName" value="${itemName}"
                placeholder="${L("WOD5E.WTA.NewGift")}" />
            </div>
          </div>

          <input type="hidden" name="giftType_hidden"     value="${giftType}" />
          <input type="hidden" name="renown_hidden"       value="${renown}" />
          <input type="hidden" name="riteGiftType_hidden" value="${riteGiftType}" />
          <input type="hidden" name="riteRenown_hidden"   value="${renown}" />

          <div id="gift-section">
            <h3>${L("WOD5E.WTA.Gifts")}</h3>
            <div class="g3">
              <div>
                <label>${L("WOD5E.WTA.GiftType")}</label>
                <select id="sel-giftType" name="giftType">
                  ${optHtml(GIFT_TYPES(), giftType)}
                </select>
              </div>
              <div>
                <label>${L("WOD5E.WTA.Renown")}</label>
                <select id="sel-renown" name="renown">
                  ${optHtml(RENOWN_TYPES(), renown)}
                </select>
              </div>
              <div>
                <label>${L("WOD5E.Level")}</label>
                <input type="number" name="level" value="${level}" min="1" max="5" />
              </div>
            </div>
          </div>

          <div id="rite-section" style="display:none;">
            <h3>${L("WOD5E.WTA.Rites")}</h3>
            <div class="g2">
              <div>
                <label>${L("WOD5E.WTA.Rite")}</label>
                <select id="sel-riteGiftType" name="riteGiftType">
                  ${optHtml(RITE_GIFT_TYPES(), riteGiftType)}
                </select>
              </div>
              <div>
                <label>${L("WOD5E.WTA.Renown")}</label>
                <select id="sel-riteRenown" name="riteRenown">
                  ${optHtml(RENOWN_TYPES(), renown)}
                </select>
              </div>
            </div>
          </div>

          <h3>${L("WOD5E.ItemsList.Cost")}</h3>
          <div class="g2">
            <div>
              <label>${L("WOD5E.WTA.RageCost")}</label>
              <input type="number" name="cost" value="${cost}" min="0" max="5" />
            </div>
            <div>
              <label>${L("WOD5E.WTA.WillpowerCost")}</label>
              <input type="number" name="willpowercost" value="${willpowercost}" min="0" max="5" />
            </div>
          </div>

          <h3>${L("WOD5E.ItemsList.Sourcebook")}</h3>
          <div class="g2">
            <div>
              <label>${L("WOD5E.ItemsList.Label")}</label>
              <input type="text" name="sourceBook" value="${sourceBook}"
                placeholder="W5 Core" />
            </div>
            <div>
              <label>${L("WOD5E.ItemsList.PageNumber")}</label>
              <input type="text" name="sourcePage" value="${sourcePage}"
                placeholder="148" />
            </div>
          </div>`;
      },

      postRender: (el) => {
        const sel           = el.querySelector("#sel-displaytype");
        const giftS         = el.querySelector("#gift-section");
        const riteS         = el.querySelector("#rite-section");
        const selGiftType   = el.querySelector("#sel-giftType");
        const selRenown     = el.querySelector("#sel-renown");
        const selRiteGT     = el.querySelector("#sel-riteGiftType");
        const selRiteRenown = el.querySelector("#sel-riteRenown");
        const hidGiftType   = el.querySelector('[name="giftType_hidden"]');
        const hidRenown     = el.querySelector('[name="renown_hidden"]');
        const hidRiteGT     = el.querySelector('[name="riteGiftType_hidden"]');
        const hidRiteRenown = el.querySelector('[name="riteRenown_hidden"]');

        selGiftType?.addEventListener("change",   () => { hidGiftType.value   = selGiftType.value; });
        selRenown?.addEventListener("change",     () => { hidRenown.value     = selRenown.value; });
        selRiteGT?.addEventListener("change",     () => { hidRiteGT.value     = selRiteGT.value; });
        selRiteRenown?.addEventListener("change", () => { hidRiteRenown.value = selRiteRenown.value; });

        function toggle() {
          const isRite = sel.value === "rite";
          giftS.style.display = isRite ? "none" : "";
          riteS.style.display = isRite ? ""     : "none";
        }
        sel?.addEventListener("change", toggle);
        toggle();
      },

      collect: (html, s) => {
        const name = html.find('[name="itemName"]').val()?.trim();
        if (!name) { ui.notifications.warn(L("WOD5E.WTA.NoGiftSelected")); return false; }
        const displayType  = html.find('[name="displayType"]').val() || "gift";
        const isRite       = displayType === "rite";
        const giftType     = html.find('[name="giftType_hidden"]').val()     || "native";
        const riteGiftType = html.find('[name="riteGiftType_hidden"]').val() || "rite";
        const renown       = html.find('[name="renown_hidden"]').val()       || "glory";
        const riteRenown   = html.find('[name="riteRenown_hidden"]').val()   || "wisdom";
        s.d1 = {
          displayType, isRite, itemName: name,
          giftType:      isRite ? riteGiftType : giftType,
          renown:        isRite ? riteRenown   : renown,
          level:         isRite ? null : (parseInt(html.find('[name="level"]').val()) || 1),
          cost:          parseInt(html.find('[name="cost"]').val())          || 0,
          willpowercost: parseInt(html.find('[name="willpowercost"]').val()) || 0,
          sourceBook:    html.find('[name="sourceBook"]').val()?.trim()      || "",
          sourcePage:    html.find('[name="sourcePage"]').val()?.trim()      || "",
        };
      },
    },

    // ── Schritt 3: Würfelpool ──────────────────────────────────────────────
    {
      title: `${L("WOD5E.WTA.GiftsandRites")} — 2/3: ${L("WOD5E.Tabs.Dicepool")}`,
      html: (s) => {
        const pool = s.d2?.pool ?? s.parsed?.pool ?? [];
        return `
          <h3>${L("WOD5E.Tabs.Dicepool")}</h3>
          <p class="hint">${L("WOD5E.ItemsList.NoDiceSelectedHint")}</p>
          <div id="pool-container">${renderPoolRows(pool)}</div>
          <button type="button" id="btn-add-pool" style="margin-top:8px;width:100%;">
            + ${L("WOD5E.ItemsList.AddDice")}
          </button>`;
      },
      postRender: (el) => {
        const container = el.querySelector("#pool-container");
        if (container) reattachPoolListeners(container);
      },
      collect: (html, s) => {
        const pool = [];
        let i = 0;
        while (true) {
          const sel = html.find(`[name="pool_path_${i}"]`);
          if (!sel.length) break;
          const val = sel.val();
          if (val) pool.push({ path: val });
          i++;
        }
        s.d2 = { pool };
      },
    },

    // ── Schritt 4: Beschreibung & Bestätigung ─────────────────────────────
    {
      title: `${L("WOD5E.WTA.GiftsandRites")} — 3/3: ${L("WOD5E.Tabs.Description")}`,
      nextLabel: `✅ ${L("WOD5E.Save")}`,
      html: (s) => {
        const isRite      = s.d1?.isRite ?? false;
        const giftTypes   = isRite ? RITE_GIFT_TYPES() : GIFT_TYPES();
        const typeLabel   = giftTypes.find(t => t.value === s.d1?.giftType)?.label ?? s.d1?.giftType;
        const renownLabel = RENOWN_TYPES().find(r => r.value === s.d1?.renown)?.label ?? s.d1?.renown;
        const poolOpts    = POOL_OPTIONS();
        const poolSummary = (s.d2?.pool ?? [])
          .map(e => poolOpts.find(o => o.value === e.path)?.label ?? e.path)
          .join(" + ") || "–";
        const desc = s.d3?.description ?? s.parsed?.description ?? "";

        return `
          <h3>${L("WOD5E.Tabs.Description")}</h3>
          <p class="hint">HTML: <code>&lt;p&gt;</code>, <code>&lt;strong&gt;</code> …</p>
          <textarea name="description" rows="9">${desc}</textarea>

          <h3 style="margin-top:18px;">${L("WOD5E.WTA.GiftsAndRenown")}</h3>
          <table>
            <tr><td style="font-weight:bold;">${L("WOD5E.Name")}</td>
                <td>${s.d1?.itemName ?? "–"}</td></tr>
            <tr><td style="font-weight:bold;">${L("WOD5E.WTA.GiftType")}</td>
                <td>${isRite ? L("WOD5E.WTA.Rite") : L("WOD5E.WTA.Gift")}</td></tr>
            <tr><td style="font-weight:bold;">${isRite ? L("WOD5E.WTA.Rite") : L("WOD5E.WTA.GiftType")}</td>
                <td>${typeLabel}</td></tr>
            <tr><td style="font-weight:bold;">${L("WOD5E.WTA.Renown")}</td>
                <td>${renownLabel}</td></tr>
            ${!isRite
              ? `<tr><td style="font-weight:bold;">${L("WOD5E.Level")}</td>
                     <td>${s.d1?.level ?? "–"}</td></tr>`
              : ""}
            <tr><td style="font-weight:bold;">${L("WOD5E.WTA.RageCost")}</td>
                <td>${s.d1?.cost ?? 0}</td></tr>
            <tr><td style="font-weight:bold;">${L("WOD5E.WTA.WillpowerCost")}</td>
                <td>${s.d1?.willpowercost ?? 0}</td></tr>
            <tr><td style="font-weight:bold;">${L("WOD5E.Tabs.Dicepool")}</td>
                <td>${poolSummary}</td></tr>
            <tr><td style="font-weight:bold;">${L("WOD5E.ItemsList.Sourcebook")}</td>
                <td>${s.d1?.sourceBook
                  ? `${s.d1.sourceBook} ${L("WOD5E.ItemsList.PageNumber")} ${s.d1.sourcePage}`
                  : "–"}</td></tr>
          </table>`;
      },
      postRender: null,
      collect: (html, s) => {
        s.d3 = { description: html.find('[name="description"]').val()?.trim() || "" };
      },
    },

  ]; // Ende STEPS

  // ═══════════════════════════════════════════════════════════════════════════
  // DIALOG-ENGINE
  // ═══════════════════════════════════════════════════════════════════════════
  function showStepWithPost(step, stepIdx) {
    return new Promise((resolve) => {
      const title     = step.title;
      const bodyHtml  = step.html(state);
      const showBack  = stepIdx > 0;
      const nextLabel = step.nextLabel || `${L("WOD5E.Submit") ?? "OK"} →`;

      class StepDialog extends AppV2 {
        static DEFAULT_OPTIONS = {
          id: `wod-item-step-${Date.now()}`,
          tag: "div",
          window: { title, resizable: true },
          position: { width: 620 },
        };
        async _renderHTML(_ctx, _opt) {
          const wrap = document.createElement("div");
          wrap.innerHTML = `
            ${baseStyle}
            <div class="wf" style="padding:0 2px;">${bodyHtml}</div>
            <div style="display:flex;justify-content:space-between;align-items:center;
                        gap:8px;margin-top:14px;padding-top:10px;
                        border-top:1px solid var(--color-border-light-primary,#aaa);">
              <div>${showBack
                ? `<button type="button" id="wod-btn-back" style="min-width:90px;">← ${L("WOD5E.Reset") ?? "Back"}</button>`
                : ""}</div>
              <div style="display:flex;gap:8px;">
                <button type="button" id="wod-btn-cancel" style="min-width:90px;">${L("WOD5E.Cancel")}</button>
                <button type="button" id="wod-btn-next"
                  style="min-width:130px;font-weight:bold;">${nextLabel}</button>
              </div>
            </div>`;
          return wrap;
        }
        _replaceHTML(result, content, _opt) {
          content.replaceChildren(result);
          if (step.postRender) step.postRender(content);
          content.querySelector("#wod-btn-next")?.addEventListener("click", () => {
            const snapshot = $(this.element);
            this.close({ animate: false });
            resolve({ html: snapshot, action: "next" });
          });
          content.querySelector("#wod-btn-back")?.addEventListener("click", () => {
            this.close({ animate: false }); resolve({ html: null, action: "back" });
          });
          content.querySelector("#wod-btn-cancel")?.addEventListener("click", () => {
            this.close({ animate: false }); resolve({ html: null, action: "cancel" });
          });
        }
        _onClose(_opt) { resolve({ html: null, action: "cancel" }); }
      }

      new StepDialog().render(true);
    });
  }

  // ─── Haupt-Schleife ────────────────────────────────────────────────────────
  let stepIdx = 0;
  while (stepIdx < STEPS.length) {
    const step = STEPS[stepIdx];
    if (step.skip && step.skip(state)) { stepIdx++; continue; }
    const result = await showStepWithPost(step, stepIdx);
    if (result.action === "cancel") {
      ui.notifications.warn(L("WOD5E.WTA.NoGiftSelected")); return;
    }
    if (result.action === "back") {
      stepIdx--;
      while (stepIdx > 0 && STEPS[stepIdx].skip && STEPS[stepIdx].skip(state)) stepIdx--;
      continue;
    }
    if (step.collect(result.html, state) === false) continue;
    stepIdx++;
  }

  // ═══════════════════════════════════════════════════════════════════════════
  // Item anlegen
  // ═══════════════════════════════════════════════════════════════════════════
  const { d1, d2, d3 } = state;

  const dicepool = {};
  for (const entry of (d2.pool ?? [])) {
    dicepool[foundry.utils.randomID(16)] = { path: entry.path };
  }

  const itemData = {
    name:   d1.itemName,
    type:   "gift",
    img:    "systems/wod5e/assets/icons/items/gift.png",
    system: {
      description:   d3.description,
      bonuses:       [],
      source:        { book: d1.sourceBook, page: d1.sourcePage },
      giftType:      d1.giftType,
      renown:        d1.renown,
      level:         d1.level,
      cost:          d1.cost,
      willpowercost: d1.willpowercost,
      dicepool,
      macroid:       "",
      dataItemId:    "",
      selected:      false,
    },
    effects: [], folder: null, flags: {},
  };

  try {
    const item = await Item.create(itemData);
    await item.update({});
    ui.notifications.info(
      `✅ ${item.name} (${L(item.system.giftType === "rite" ? "WOD5E.WTA.Rite" : "WOD5E.WTA.Gift")}) ${L("WOD5E.Save")}`
    );
    setTimeout(() => { game.items.get(item.id)?.sheet.render(true); }, 300);
  } catch (err) {
    console.error("WoD5e Item Creator – Fehler:", err);
    ui.notifications.error(err.message);
  }

})();
